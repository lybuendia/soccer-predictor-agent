# LLM provider — "openai" or "claude"
LLM_PROVIDER=openai

# LLM API keys (only the active provider is required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Data APIs
FOOTBALL_DATA_API_KEY=    # https://www.football-data.org — free tier supports Premier League
ODDS_API_KEY=             # https://the-odds-api.com — free tier: 500 requests/month
SEARCH_API_KEY=           # https://tavily.com — free tier: 1000 requests/month

# Email (SMTP with STARTTLS — Gmail app password works here)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# Storage paths
DB_PATH=soccer_forecast.db
CHROMA_PATH=.chroma
